# ========================================================
# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to backend/.env and insert your API keys
# ========================================================

# Gemini API Credentials (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Primary Gemini Model Endpoint
GEMINI_MODEL=gemini-3.5-flash

# Application Environment (development, testing, production)
APP_ENV=development

# Persistent SQLite Storage
DATABASE_URL=sqlite:///./data/jarvis.db

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Server Host & Port
HOST=127.0.0.1
PORT=8000

